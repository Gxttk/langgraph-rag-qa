# ===== 大模型（DeepSeek）=====
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding（阿里云 DashScope）=====
DASHSCOPE_API_KEY=your_dashscope_key_here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512

# ===== Milvus 向量库（本地直连用 localhost；容器内由 compose 覆盖为服务名）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=langgraph_rag_kb

# ===== 文档分块与入库 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBED_BATCH_SIZE=10
MIN_CHUNK_LEN=20

# ===== 检索 =====
RETRIEVE_TOP_K=4
REWRITE_NUM_QUERIES=3
MAX_RETRIEVE_RETRIES=2

# ===== 多轮会话：问题补全 / 生成时携带的最近消息条数（6 条 ≈ 3 轮）=====
MAX_HISTORY_MESSAGES=6

# ===== LLM 分节点温度（越低越确定、越不易发散）=====
# condense 问题补全 / rerank 精排 / evaluate 评估 / answer 生成 / rewrite 查询改写
TEMP_CONDENSE=0.1
TEMP_RERANK=0.0
TEMP_EVAL=0.1
TEMP_ANSWER=0.2
TEMP_REWRITE=0.5

# ===== API 服务与日志 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ===== LangSmith 可观测（可选，不填不影响运行）=====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=langgraph-rag-qa
